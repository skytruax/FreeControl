<Bindings>
	<!-- The two page buttons in the middle of the bar, so that any button or key can turn the page
	     (Options > Key Bindings > FreeControl). They are click bindings on secure buttons, which is
	     what lets them work in a fight; their names are set in Bindings.lua. Everything else the
	     addon needs it binds itself. -->
	<Binding name="CLICK FreeControlPageNext:LeftButton" category="FreeControl"/>
	<Binding name="CLICK FreeControlPagePrev:LeftButton" category="FreeControl"/>
	<Binding name="CLICK FreeControlLayerRelease:LeftButton" category="FreeControl"/>
	<!-- Stepping through the party: next, previous, first and last (Layout.PARTY_JOBS). -->
	<Binding name="CLICK FreeControlPartyNext:LeftButton" category="FreeControl"/>
	<Binding name="CLICK FreeControlPartyPrev:LeftButton" category="FreeControl"/>
	<Binding name="CLICK FreeControlPartyFirst:LeftButton" category="FreeControl"/>
	<Binding name="CLICK FreeControlPartyLast:LeftButton" category="FreeControl"/>
</Bindings>
